+// All ten I4 modes transform the same source block. Build the source half of
+// the exact horizontal transform once while otherwise-idle prediction lanes
+// are available; per-mode lanes subtract the reference half before applying
+// the original rounding constants.
+__device__ __forceinline__ void I4FTransformSourceRow(
+    const uint8_t* src, int* source_tmp, int row) {
+  const uint8_t* const s = src + row * kCudaBPS;
+  const int a0 = s[0] + s[3];
+  const int a1 = s[1] + s[2];
+  const int a2 = s[1] - s[2];
+  const int a3 = s[0] - s[3];
+  source_tmp[0 + row * 4] = (a0 + a1) * 8;
+  source_tmp[1 + row * 4] = a2 * 2217 + a3 * 5352;
+  source_tmp[2 + row * 4] = (a0 - a1) * 8;
+  source_tmp[3 + row * 4] = a3 * 2217 - a2 * 5352;
+}
+
+__device__ __forceinline__ void I4FTransformCoop4SourceReuse(
+    const uint8_t* ref, const int* source_tmp, int16_t* out, int* tmp,
+    int lane, unsigned int warp_mask) {
+  const uint8_t* const r = ref + lane * kCudaBPS;
+  const int a0 = r[0] + r[3];
+  const int a1 = r[1] + r[2];
+  const int a2 = r[1] - r[2];
+  const int a3 = r[0] - r[3];
+  tmp[0 + lane * 4] = source_tmp[0 + lane * 4] - (a0 + a1) * 8;
+  tmp[1 + lane * 4] =
+      (source_tmp[1 + lane * 4] - (a2 * 2217 + a3 * 5352) + 1812) >> 9;
+  tmp[2 + lane * 4] = source_tmp[2 + lane * 4] - (a0 - a1) * 8;
+  tmp[3 + lane * 4] =
+      (source_tmp[3 + lane * 4] - (a3 * 2217 - a2 * 5352) + 937) >> 9;
+  __syncwarp(warp_mask);
+
+  const int b0 = tmp[0 + lane] + tmp[12 + lane];
+  const int b1 = tmp[4 + lane] + tmp[8 + lane];
+  const int b2 = tmp[4 + lane] - tmp[8 + lane];
+  const int b3 = tmp[0 + lane] - tmp[12 + lane];
+  out[0 + lane] = (int16_t)((b0 + b1 + 7) >> 4);
+  out[4 + lane] =
+      (int16_t)(((b2 * 2217 + b3 * 5352 + 12000) >> 16) + (b3 != 0));
+  out[8 + lane] = (int16_t)((b0 - b1 + 7) >> 4);
+  out[12 + lane] = (int16_t)((b3 * 2217 - b2 * 5352 + 51000) >> 16);
+}
+#endif
