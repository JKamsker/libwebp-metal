+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 800
+// ResidualCostDev with the quantizer's exact last-nonzero index. Basic I4
+// quantization already visits every coefficient, so this avoids rescanning
+// the sixteen published levels on the residual warp's critical path.
+__device__ int ResidualCostKnownLastDev(const CostCache* c, int ctx0,
+                                        int first, int coeff_type,
+                                        const int16_t* coeffs, int last) {
+  int n = first;
+  const int p0 = FirstProba(c, coeff_type, kEncBands[n], ctx0);
+  const uint16_t* t = LevelCostTable(c, coeff_type, kEncBands[n], ctx0);
+  int cost = (ctx0 == 0) ? BitCostDev(c, 1, p0) : 0;
+  if (last < 0) {
+    return BitCostDev(c, 0, p0);
+  }
+  for (; n < last; ++n) {
+    const int val = CudaAbs(coeffs[n]);
+    const int ctx = (val >= 2) ? 2 : val;
+    cost += LevelCostDev(c, t, val);
+    t = LevelCostTable(c, coeff_type, kEncBands[n + 1], ctx);
+  }
+  {
+    const int val = CudaAbs(coeffs[n]);
+    cost += LevelCostDev(c, t, val);
+    if (n < 15) {
+      const int b = kEncBands[n + 1];
+      const int ctx = (val == 1) ? 1 : 2;
+      const int last_p0 = FirstProba(c, coeff_type, b, ctx);
+      cost += BitCostDev(c, 0, last_p0);
+    }
+  }
+  return cost;
+}
+#endif
