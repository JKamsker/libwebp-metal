+              (uint32_t)next_range | ((uint32_t)shift << 8) |
+              ((uint32_t)add << 16);
+        }
+      }
+    }
+    __atomic_store_n(&kTokenTransitionsState, 2, __ATOMIC_RELEASE);
+  } else {
+    while (__atomic_load_n(&kTokenTransitionsState, __ATOMIC_ACQUIRE) != 2) {
+    }
+  }
+}
