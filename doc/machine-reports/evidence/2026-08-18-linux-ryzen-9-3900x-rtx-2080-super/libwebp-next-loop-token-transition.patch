+static void InitTokenTransitions(void) {
+  int expected = 0;
+  if (__atomic_load_n(&kTokenTransitionsState, __ATOMIC_ACQUIRE) == 2) return;
+  if (__atomic_compare_exchange_n(&kTokenTransitionsState, &expected, 1, 0,
+                                  __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+    int range;
+    for (range = 127; range <= 254; ++range) {
+      int prob;
+      for (prob = 0; prob <= 255; ++prob) {
+        const int split = (range * prob) >> 8;
+        int bit;
+        for (bit = 0; bit <= 1; ++bit) {
+          const int add = bit ? split + 1 : 0;
+          int next_range = bit ? range - add : split;
+          int shift = 0;
