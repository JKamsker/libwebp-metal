+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 800
+// Fuses the basic four-lane I4 transform, quantizer, and inverse-transform
+// setup. Each lane owns one coefficient column after the forward transform,
+// so it can quantize that column and feed it directly into the inverse
+// transform without publishing/reloading the coefficients through shared
+// memory. The zigzag levels remain in their exact encoder order.
+__device__ __forceinline__ int I4TransformQuantizeCoop4(
+    const uint8_t* src, const uint8_t* ref, int16_t* levels, uint8_t* dst,
+    int* tmp, const CudaVP8Matrix* mtx, int lane,
+    unsigned int warp_mask) {
+  __device__ static const uint8_t kInverseZigzag[16] = {
+      0, 1, 5, 6, 2, 4, 7, 12, 3, 8, 11, 13, 9, 10, 14, 15};
+  const uint8_t* const src_row = src + lane * kCudaBPS;
+  const uint8_t* const ref_row = ref + lane * kCudaBPS;
+  const int d0 = src_row[0] - ref_row[0];
+  const int d1 = src_row[1] - ref_row[1];
+  const int d2 = src_row[2] - ref_row[2];
+  const int d3 = src_row[3] - ref_row[3];
+  const int a0 = d0 + d3;
+  const int a1 = d1 + d2;
+  const int a2 = d1 - d2;
+  const int a3 = d0 - d3;
+  int16_t coeffs[4];
+  int non_zero = 0;
+  tmp[0 + lane * 4] = (a0 + a1) * 8;
+  tmp[1 + lane * 4] = (a2 * 2217 + a3 * 5352 + 1812) >> 9;
+  tmp[2 + lane * 4] = (a0 - a1) * 8;
+  tmp[3 + lane * 4] = (a3 * 2217 - a2 * 5352 + 937) >> 9;
+  __syncwarp(warp_mask);
+
+  {
+    const int b0 = tmp[0 + lane] + tmp[12 + lane];
+    const int b1 = tmp[4 + lane] + tmp[8 + lane];
+    const int b2 = tmp[4 + lane] - tmp[8 + lane];
+    const int b3 = tmp[0 + lane] - tmp[12 + lane];
+    coeffs[0] = (int16_t)((b0 + b1 + 7) >> 4);
+    coeffs[1] =
+        (int16_t)(((b2 * 2217 + b3 * 5352 + 12000) >> 16) + (b3 != 0));
+    coeffs[2] = (int16_t)((b0 - b1 + 7) >> 4);
+    coeffs[3] = (int16_t)((b3 * 2217 - b2 * 5352 + 51000) >> 16);
+  }
+
+#pragma unroll
+  for (int row = 0; row < 4; ++row) {
+    const int j = lane + 4 * row;
+    const int n = kInverseZigzag[j];
+    const int sign = (coeffs[row] < 0);
+    const uint32_t coeff =
+        (uint32_t)(sign ? -coeffs[row] : coeffs[row]) + mtx->sharpen[j];
+    if (coeff > mtx->zthresh[j]) {
+      const uint32_t Q = mtx->q[j];
+      int level = CudaQuantDiv(coeff, mtx->iq[j], mtx->bias[j]);
+      if (level > kMaxLevel) level = kMaxLevel;
+      if (sign) level = -level;
+      coeffs[row] = (int16_t)(level * (int)Q);
+      levels[n] = (int16_t)level;
+      non_zero |= level;
+    } else {
+      coeffs[row] = 0;
+      levels[n] = 0;
+    }
+  }
+
+  {
+    const int a = coeffs[0] + coeffs[2];
+    const int b = coeffs[0] - coeffs[2];
+    const int c = CudaTransformAc3Mul2(coeffs[1]) -
+                  CudaTransformAc3Mul1(coeffs[3]);
+    const int d = CudaTransformAc3Mul1(coeffs[1]) +
+                  CudaTransformAc3Mul2(coeffs[3]);
+    tmp[0 + lane * 4] = a + d;
+    tmp[1 + lane * 4] = b + c;
+    tmp[2 + lane * 4] = b - c;
+    tmp[3 + lane * 4] = a - d;
+  }
+  __syncwarp(warp_mask);
+  {
+    const int dc = tmp[lane] + 4;
+    const int e = dc + tmp[8 + lane];
+    const int f = dc - tmp[8 + lane];
+    const int g = CudaTransformAc3Mul2(tmp[4 + lane]) -
+                  CudaTransformAc3Mul1(tmp[12 + lane]);
+    const int h = CudaTransformAc3Mul1(tmp[4 + lane]) +
+                  CudaTransformAc3Mul2(tmp[12 + lane]);
+    uint8_t* const dst_row = dst + lane * kCudaBPS;
+    dst_row[0] = CudaClip8b(ref_row[0] + ((e + h) >> 3));
+    dst_row[1] = CudaClip8b(ref_row[1] + ((f + g) >> 3));
+    dst_row[2] = CudaClip8b(ref_row[2] + ((f - g) >> 3));
+    dst_row[3] = CudaClip8b(ref_row[3] + ((e - h) >> 3));
+  }
+
+  {
+    const unsigned int group_shift = ((threadIdx.x & 31) >> 2) * 4;
+    const unsigned int group_mask = 0xfu << group_shift;
+    const unsigned int non_zero_lanes =
+        __ballot_sync(warp_mask, non_zero != 0);
+    return (non_zero_lanes & group_mask) != 0;
+  }
+}
+#endif
