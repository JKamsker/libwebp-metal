+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 800
+// Two adjacent lanes evaluate one residual in eight coefficient waves. This
+// halves the scalar dependency chain while keeping all ten I4 modes in warp 0.
+__device__ __forceinline__ int ResidualCostCoop2(
+    const CostCache* c, int ctx0, int coeff_type, const int16_t* coeffs,
+    int lane, unsigned int group_mask) {
+  int values[8];
+  int last = -1;
+#pragma unroll
+  for (int wave = 0; wave < 8; ++wave) {
+    const int n = 2 * wave + lane;
+    const int value = CudaAbs(coeffs[n]);
+    values[wave] = value;
+    if (value != 0) last = n;
+  }
+  const int other = __shfl_xor_sync(group_mask, last, 1, 2);
+  if (other > last) last = other;
+
+  const int p0 = FirstProba(c, coeff_type, kEncBands[0], ctx0);
+  if (last < 0) return BitCostDev(c, 0, p0);
+
+  int cost = 0;
+#pragma unroll
+  for (int wave = 0; wave < 8; ++wave) {
+    const int n = 2 * wave + lane;
+    const int value = values[wave];
+    int previous = __shfl_up_sync(group_mask, value, 1, 2);
+    const int prior_wave_last =
+        (wave == 0)
+            ? 0
+            : __shfl_sync(group_mask, values[wave - 1], 1, 2);
+    if (lane == 0) {
+      previous = prior_wave_last;
+    }
+    if (n <= last) {
+      const int ctx = (n == 0) ? ctx0 : ((previous >= 2) ? 2 : previous);
+      const uint16_t* const table =
+          LevelCostTable(c, coeff_type, kEncBands[n], ctx);
+      cost += LevelCostDev(c, table, value);
+      if (n == last && n < 15) {
+        const int eob_ctx = (value == 1) ? 1 : 2;
+        cost += BitCostDev(
+            c, 0, FirstProba(c, coeff_type, kEncBands[n + 1], eob_ctx));
+      }
+    }
+  }
+  cost += __shfl_down_sync(group_mask, cost, 1, 2);
+  return cost + ((ctx0 == 0) ? BitCostDev(c, 1, p0) : 0);
+}
+#endif
