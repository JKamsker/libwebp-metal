+bool DecimateHasUniformY1AC(
+    const WebPAcceleratorDecimateRequest* request) {
+  for (int segment = 0; segment < 4; ++segment) {
+    const WebPAcceleratorQuantMatrix* const y1 =
+        &request->segment_params[segment].y1;
+    for (int i = 2; i < 16; ++i) {
+      if (y1->q[i] != y1->q[1] || y1->iq[i] != y1->iq[1] ||
+          y1->bias[i] != y1->bias[1] ||
+          y1->zthresh[i] != y1->zthresh[1]) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
