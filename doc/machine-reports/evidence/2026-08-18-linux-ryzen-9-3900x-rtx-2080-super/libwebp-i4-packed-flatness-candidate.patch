+// The I4 level arrays are 32-byte rows. Turing's scalar CudaIsFlat walk is a
+// line-resolved instruction hot spot, so inspect two adjacent 16-bit levels
+// per shared-memory load while retaining the same early threshold decision.
+__device__ __forceinline__ int I4IsFlatPacked2(const int16_t* levels,
+                                               int thresh) {
+  const uint32_t* const packed = (const uint32_t*)levels;
+  int score = ((packed[0] >> 16) != 0);  // omit DC (levels[0])
+  if (score > thresh) return 0;
+  for (int i = 1; i < 8; ++i) {
+    const uint32_t pair = packed[i];
+    score += ((pair & 0xffffu) != 0) + ((pair >> 16) != 0);
+    if (score > thresh) return 0;
+  }
+  return 1;
+}
