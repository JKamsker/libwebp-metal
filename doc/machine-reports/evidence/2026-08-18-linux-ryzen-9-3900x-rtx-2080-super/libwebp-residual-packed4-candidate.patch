+// Pre-Ampere I4 residual scorer. Load the sixteen contiguous coefficients as
+// four packed shared-memory words, then retain the scalar scoring dependency.
+// This reduces shared-load instructions without changing the bit-cost path.
+__device__ int ResidualCostPacked4Dev(const CostCache* c, int ctx0, int first,
+                                      int coeff_type,
+                                      const int16_t* coeffs) {
+  const unsigned long long* const packed_coeffs =
+      reinterpret_cast<const unsigned long long*>(coeffs);
+  const unsigned long long packed0 = packed_coeffs[0];
+  const unsigned long long packed1 = packed_coeffs[1];
+  const unsigned long long packed2 = packed_coeffs[2];
+  const unsigned long long packed3 = packed_coeffs[3];
+  const unsigned long long packed[4] = {packed0, packed1, packed2, packed3};
+  int last = -1;
+  for (int n = 15; n >= 0; --n) {
+    const int val = (int)(int16_t)(packed[n >> 2] >> ((n & 3) * 16));
+    if (val != 0) {
+      last = n;
+      break;
+    }
+  }
+  int n = first;
+  const int p0 = FirstProba(c, coeff_type, kEncBands[n], ctx0);
+  const uint16_t* t = LevelCostTable(c, coeff_type, kEncBands[n], ctx0);
+  int cost = (ctx0 == 0) ? BitCostDev(c, 1, p0) : 0;
+  if (last < 0) {
+    return BitCostDev(c, 0, p0);
+  }
+  for (; n < last; ++n) {
+    const int coeff = (int)(int16_t)(packed[n >> 2] >> ((n & 3) * 16));
+    const int val = abs(coeff);
+    const int ctx = (val >= 2) ? 2 : val;
+    cost += LevelCostDev(c, t, val);
+    t = LevelCostTable(c, coeff_type, kEncBands[n + 1], ctx);
+  }
+  {
+    const int coeff = (int)(int16_t)(packed[n >> 2] >> ((n & 3) * 16));
+    const int val = abs(coeff);
+    cost += LevelCostDev(c, t, val);
+    if (n < 15) {
+      const int b = kEncBands[n + 1];
+      const int ctx = (val == 1) ? 1 : 2;
+      const int last_p0 = FirstProba(c, coeff_type, b, ctx);
+      cost += BitCostDev(c, 0, last_p0);
+    }
+  }
+  return cost;
+}
