+int VP8EmitTokens8(VP8TBuffer buffers[8], VP8BitWriter bws[8],
+                   const uint8_t* const probas) {
+  VP8Tokens* pages[8];
+  VP8BitWriter* writers[8];
+  int lane;
+  for (lane = 0; lane < 8; ++lane) {
+    pages[lane] = buffers[lane].pages;
+    writers[lane] = &bws[lane];
+  }
+  for (;;) {
+    const uint16_t* page_tokens[8];
+    int num_tokens[8], first_token[8];
+    int any_page = 0;
+    for (lane = 0; lane < 8; ++lane) {
+      if (pages[lane] != NULL) {
+        const VP8Tokens* const next = pages[lane]->next;
+        page_tokens[lane] = TOKEN_DATA(pages[lane]);
+        num_tokens[lane] = buffers[lane].page_size;
+        first_token[lane] = (next == NULL) ? buffers[lane].left : 0;
+        any_page = 1;
+      } else {
+        page_tokens[lane] = NULL;
+        num_tokens[lane] = first_token[lane] = 0;
+      }
+    }
+    if (!any_page) break;
+    VP8PutTokenPages8(writers, page_tokens, num_tokens, first_token, probas);
+    for (lane = 0; lane < 8; ++lane) {
+      if (pages[lane] != NULL) {
+        VP8Tokens* const next = pages[lane]->next;
+        WebPSafeFree(pages[lane]);
+        pages[lane] = next;
+      }
+    }
+  }
+  for (lane = 0; lane < 8; ++lane) buffers[lane].pages = NULL;
+  return 1;
+}
