+void VP8PutTokenPages8(VP8BitWriter* const bws[8],
+                       const uint16_t* const tokens[8],
+                       const int num_tokens[8], const int first_token[8],
+                       const uint8_t* const probas) {
+  PutTokenPages8AVX2(bws, tokens, num_tokens, first_token, probas);
+}
+#else
+int VP8TokenPages8Available(void) { return 0; }
+
+void VP8PutTokenPages8(VP8BitWriter* const bws[8],
+                       const uint16_t* const tokens[8],
+                       const int num_tokens[8], const int first_token[8],
+                       const uint8_t* const probas) {
+  int lane;
+  for (lane = 0; lane < 8; ++lane) {
+    VP8PutTokenPage(bws[lane], tokens[lane], num_tokens[lane],
+                    first_token[lane], probas);
+  }
+}
