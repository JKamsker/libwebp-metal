+__attribute__((target("avx2")))
+static void PutTokenPages8AVX2(VP8BitWriter* const bws[8],
+                               const uint16_t* const tokens[8],
+                               const int num_tokens[8],
+                               const int first_token[8],
+                               const uint8_t* const probas) {
+  int range[8], value[8], nb_bits[8], next_token[8];
+  int lane;
+  __m256i ranges, values, pending_bits;
+  const __m256i zero = _mm256_setzero_si256();
+  const __m256i one = _mm256_set1_epi32(1);
+  const __m256i low_byte = _mm256_set1_epi32(0xff);
+  for (lane = 0; lane < 8; ++lane) {
+    assert(first_token[lane] >= 0);
+    assert(first_token[lane] <= num_tokens[lane]);
+    range[lane] = bws[lane]->range;
+    value[lane] = bws[lane]->value;
+    nb_bits[lane] = bws[lane]->nb_bits;
+    next_token[lane] = num_tokens[lane] - 1;
+  }
+  ranges = _mm256_loadu_si256((const __m256i*)range);
+  values = _mm256_loadu_si256((const __m256i*)value);
+  pending_bits = _mm256_loadu_si256((const __m256i*)nb_bits);
+  for (;;) {
+    int active[8], prob[8], bit_mask[8];
+    int any_active = 0;
+    __m256i active_v, probs, bits, split, add, raw_range;
+    __m256i packed, shifts, next_range, next_value, next_nb_bits;
+    int flush_mask;
+    for (lane = 0; lane < 8; ++lane) {
+      const int is_active = (next_token[lane] >= first_token[lane]);
+      active[lane] = -is_active;
+      any_active |= is_active;
+      if (is_active) {
+        const uint16_t token = tokens[lane][next_token[lane]--];
+        bit_mask[lane] = -((int)(token >> 15) & 1);
+        prob[lane] = (token & (1u << 14))
+                         ? token & 0xffu
+                         : probas[token & 0x3fffu];
+      } else {
+        bit_mask[lane] = 0;
+        prob[lane] = 0;
+      }
+    }
+    if (!any_active) break;
+    active_v = _mm256_loadu_si256((const __m256i*)active);
+    probs = _mm256_loadu_si256((const __m256i*)prob);
+    bits = _mm256_loadu_si256((const __m256i*)bit_mask);
+    split = _mm256_srli_epi32(_mm256_mullo_epi32(ranges, probs), 8);
+    add = _mm256_add_epi32(split, one);
+    raw_range = _mm256_blendv_epi8(
+        split, _mm256_sub_epi32(ranges, add), bits);
+    packed = _mm256_i32gather_epi32((const int*)kPackedNormRange, raw_range,
+                                    (int)sizeof(kPackedNormRange[0]));
+    shifts = _mm256_srli_epi32(packed, 8);
+    next_range = _mm256_and_si256(packed, low_byte);
+    next_value = _mm256_add_epi32(values, _mm256_and_si256(add, bits));
+    next_value = _mm256_sllv_epi32(next_value, shifts);
+    next_nb_bits = _mm256_add_epi32(pending_bits, shifts);
+    ranges = _mm256_blendv_epi8(ranges, next_range, active_v);
+    values = _mm256_blendv_epi8(values, next_value, active_v);
+    pending_bits =
+        _mm256_blendv_epi8(pending_bits, next_nb_bits, active_v);
+    flush_mask = _mm256_movemask_ps(_mm256_castsi256_ps(
+        _mm256_and_si256(
+            active_v,
+            _mm256_and_si256(_mm256_cmpgt_epi32(shifts, zero),
+                             _mm256_cmpgt_epi32(pending_bits, zero)))));
+    if (flush_mask != 0) {
+      _mm256_storeu_si256((__m256i*)range, ranges);
+      _mm256_storeu_si256((__m256i*)value, values);
+      _mm256_storeu_si256((__m256i*)nb_bits, pending_bits);
+      for (lane = 0; lane < 8; ++lane) {
+        if (flush_mask & (1 << lane)) {
+          VP8BitWriter* const bw = bws[lane];
+          const int s = 8 + nb_bits[lane];
+          const int32_t out_bits = value[lane] >> s;
+          value[lane] -= (int32_t)((uint32_t)out_bits << s);
+          nb_bits[lane] -= 8;
+          if ((out_bits & 0xff) == 0xff) {
+            ++bw->run;
+          } else {
+            const size_t pending = (size_t)bw->run + 1;
+            size_t pos = bw->pos;
+            if (!((pos <= bw->max_pos &&
+                   pending <= bw->max_pos - pos) ||
+                  BitWriterResize(bw, pending))) {
+              continue;
+            }
+            if ((out_bits & 0x100) && pos > 0) bw->buf[pos - 1]++;
+            if (bw->run > 0) {
+              const int fill = (out_bits & 0x100) ? 0x00 : 0xff;
+              for (; bw->run > 0; --bw->run) bw->buf[pos++] = fill;
+            }
+            bw->buf[pos++] = out_bits & 0xff;
+            bw->pos = pos;
+          }
+        }
+      }
+      values = _mm256_loadu_si256((const __m256i*)value);
+      pending_bits = _mm256_loadu_si256((const __m256i*)nb_bits);
+    }
+  }
+  _mm256_storeu_si256((__m256i*)range, ranges);
+  _mm256_storeu_si256((__m256i*)value, values);
+  _mm256_storeu_si256((__m256i*)nb_bits, pending_bits);
+  for (lane = 0; lane < 8; ++lane) {
+    bws[lane]->range = range[lane];
+    bws[lane]->value = value[lane];
+    bws[lane]->nb_bits = nb_bits[lane];
+  }
+}
