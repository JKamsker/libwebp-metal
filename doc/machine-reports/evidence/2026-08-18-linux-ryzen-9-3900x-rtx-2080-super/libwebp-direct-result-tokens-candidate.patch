+// Codes one partition directly from the retained accelerator results after
+// the final probabilities are known. This is the same coefficient traversal
+// as RecordTokensFromResults, but it avoids constructing and then traversing
+// the packed-token pages.
+static int DirectTokenEmitJobHook(void* arg1, void* arg2) {
+#define NZ_BIT(word, n) (!!((word) & (1u << (n))))
+  DirectTokenEmitJob* const job = (DirectTokenEmitJob*)arg1;
+  VP8Encoder* const enc = job->enc;
+  const AcceleratedDecimatePass* const pass = job->pass;
+  VP8BitWriter* const bw = job->bw;
+  const int mb_w = enc->mb_w;
+  int row;
+  (void)arg2;
+  for (row = job->partition; row < enc->mb_h; row += enc->num_parts) {
+    uint32_t lnz = 0;
+    int left_nz8 = 0;
+    int mb_x;
+    for (mb_x = 0; mb_x < mb_w; ++mb_x) {
+      const WebPAcceleratorDecimateResult* const r =
+          &pass->results[row * mb_w + mb_x];
+      const uint32_t tnz =
+          (row == 0) ? 0 : pass->direct_nz[(row - 1) * mb_w + mb_x];
+      int top_nz[9], left_nz[9];
+      VP8Residual res;
+      uint32_t nz = 0;
+      int bx, by, ch;
+      top_nz[0] = NZ_BIT(tnz, 12);
+      top_nz[1] = NZ_BIT(tnz, 13);
+      top_nz[2] = NZ_BIT(tnz, 14);
+      top_nz[3] = NZ_BIT(tnz, 15);
+      top_nz[4] = NZ_BIT(tnz, 18);
+      top_nz[5] = NZ_BIT(tnz, 19);
+      top_nz[6] = NZ_BIT(tnz, 22);
+      top_nz[7] = NZ_BIT(tnz, 23);
+      top_nz[8] = NZ_BIT(tnz, 24);
+      left_nz[0] = NZ_BIT(lnz, 3);
+      left_nz[1] = NZ_BIT(lnz, 7);
+      left_nz[2] = NZ_BIT(lnz, 11);
+      left_nz[3] = NZ_BIT(lnz, 15);
+      left_nz[4] = NZ_BIT(lnz, 17);
+      left_nz[5] = NZ_BIT(lnz, 19);
+      left_nz[6] = NZ_BIT(lnz, 21);
+      left_nz[7] = NZ_BIT(lnz, 23);
+      left_nz[8] = left_nz8;
+      if (!r->is_i4) {
+        const int ctx = top_nz[8] + left_nz[8];
+        VP8InitResidual(0, 1, enc, &res);
+        VP8SetResidualCoeffs(r->y_dc_levels, &res);
+        top_nz[8] = left_nz[8] = PutCoeffs(bw, ctx, &res);
+        VP8InitResidual(1, 0, enc, &res);
+      } else {
+        VP8InitResidual(0, 3, enc, &res);
+      }
+      for (by = 0; by < 4; ++by) {
+        for (bx = 0; bx < 4; ++bx) {
+          const int ctx = top_nz[bx] + left_nz[by];
+          VP8SetResidualCoeffs(r->y_ac_levels[bx + by * 4], &res);
+          top_nz[bx] = left_nz[by] = PutCoeffs(bw, ctx, &res);
+        }
+      }
+      VP8InitResidual(0, 2, enc, &res);
+      for (ch = 0; ch <= 2; ch += 2) {
+        for (by = 0; by < 2; ++by) {
+          for (bx = 0; bx < 2; ++bx) {
+            const int ctx = top_nz[4 + ch + bx] + left_nz[4 + ch + by];
+            VP8SetResidualCoeffs(r->uv_levels[ch * 2 + bx + by * 2], &res);
+            top_nz[4 + ch + bx] = left_nz[4 + ch + by] =
+                PutCoeffs(bw, ctx, &res);
+          }
+        }
+      }
+      nz |= (top_nz[0] << 12) | (top_nz[1] << 13);
+      nz |= (top_nz[2] << 14) | (top_nz[3] << 15);
+      nz |= (top_nz[4] << 18) | (top_nz[5] << 19);
+      nz |= (top_nz[6] << 22) | (top_nz[7] << 23);
+      nz |= (top_nz[8] << 24);
+      nz |= (left_nz[0] << 3) | (left_nz[1] << 7);
+      nz |= (left_nz[2] << 11);
+      nz |= (left_nz[4] << 17) | (left_nz[6] << 21);
+      lnz = nz;
+      left_nz8 = left_nz[8];
+      if (bw->error) return 0;
+    }
+  }
+  return 1;
+#undef NZ_BIT
+}
