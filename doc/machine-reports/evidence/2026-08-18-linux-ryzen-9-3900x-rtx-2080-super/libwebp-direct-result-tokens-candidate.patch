+// A CUDA collection failure must hand an ordinary token stream to the CPU
+// fallback. Replaying the completed rows would also re-record their adaptive
+// statistics, so preserve and restore those counters around materialization.
+static int MaterializeRecordedTokens(VP8Encoder* const enc,
+                                     AcceleratedDecimatePass* const pass,
+                                     int end_row) {
+  StatsArray saved_stats[NUM_TYPES][NUM_BANDS];
+  int ok;
+  memcpy(saved_stats, enc->proba.stats, sizeof(saved_stats));
+  memset(pass->record_nz, 0,
+         (size_t)enc->mb_w * sizeof(*pass->record_nz));
+  pass->direct_results = 0;
+  ok = RecordTokensFromResults(enc, pass, 0, end_row);
+  memcpy(enc->proba.stats, saved_stats, sizeof(saved_stats));
+  return ok;
+}
