+// Records adaptive statistics in precisely the event order used above.
+// VP8RecordCoeffs groups some EOB events differently, which is observable
+// when a 16-bit counter reaches its renormalization threshold.
+int VP8RecordCoeffStatsExact(int ctx,
+                             const struct VP8Residual* const res) {
+  const int16_t* const coeffs = res->coeffs;
+  const int last = res->last;
+  int n = res->first;
+  proba_t* s = res->stats[n][ctx];
+  if (!VP8RecordStats(last >= 0, s + 0)) return 0;
+
+  while (n < 16) {
+    const int c = coeffs[n++];
+    const uint32_t v = (c < 0) ? -c : c;
+    if (!VP8RecordStats(v != 0, s + 1)) {
+      s = res->stats[VP8EncBands[n]][0];
+      continue;
+    }
+    if (!VP8RecordStats(v > 1, s + 2)) {
+      s = res->stats[VP8EncBands[n]][1];
+    } else {
+      if (!VP8RecordStats(v > 4, s + 3)) {
+        if (VP8RecordStats(v != 2, s + 4)) {
+          VP8RecordStats(v == 4, s + 5);
+        }
+      } else if (!VP8RecordStats(v > 10, s + 6)) {
+        (void)VP8RecordStats(v > 6, s + 7);
+      } else {
+        const uint32_t residue = v - 3;
+        if (residue < (8 << 1)) {
+          VP8RecordStats(0, s + 8);
+          VP8RecordStats(0, s + 9);
+        } else if (residue < (8 << 2)) {
+          VP8RecordStats(0, s + 8);
+          VP8RecordStats(1, s + 9);
+        } else if (residue < (8 << 3)) {
+          VP8RecordStats(1, s + 8);
+          VP8RecordStats(0, s + 9);
+        } else {
+          VP8RecordStats(1, s + 8);
+          VP8RecordStats(1, s + 9);
+        }
+      }
+      s = res->stats[VP8EncBands[n]][2];
+    }
+    if (n == 16 || !VP8RecordStats(n <= last, s + 0)) return 1;
+  }
+  return 1;
+}
