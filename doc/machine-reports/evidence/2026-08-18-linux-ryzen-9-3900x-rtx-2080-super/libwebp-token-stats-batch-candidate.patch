+static WEBP_INLINE void FlushStatsSlot(uint32_t slot,
+                                      proba_t* const stats) {
+  const uint32_t bits = slot & 0xffffu;
+  const uint32_t count = (slot >> 16) & 31u;
+  const uint32_t ones = (slot >> 21) & 31u;
+  proba_t p = *stats;
+  if ((p >> 16) <= 0xfffeu - count) {
+    *stats = p + (count << 16) + ones;
+  } else {
+    uint32_t i;
+    for (i = 0; i < count; ++i) {
+      VP8RecordStats((bits >> i) & 1u, stats);
+    }
+  }
+}
+
+static WEBP_INLINE void RecordStatsBatched(uint32_t bit,
+                                           proba_t* const stats,
+                                           VP8TokenStatsBatch* const batch) {
+  const size_t stats_idx = (size_t)(stats - batch->stats);
+  uint32_t slot = batch->slots[stats_idx];
+  const uint32_t count = (slot >> 16) & 31u;
+  slot += (1u << 16) + (bit << 21) + (bit << count);
+  if (count == 15u) {
+    FlushStatsSlot(slot, stats);
+    slot = 0;
+  }
+  batch->slots[stats_idx] = slot;
+}
+
+void VP8FlushTokenStatsBatch(VP8TokenStatsBatch* const batch) {
+  int i;
+  for (i = 0; i < VP8_NUM_TOKEN_STATS; ++i) {
+    const uint32_t slot = batch->slots[i];
+    if (slot != 0) {
+      FlushStatsSlot(slot, batch->stats + i);
+      batch->slots[i] = 0;
+    }
+  }
+}
+
