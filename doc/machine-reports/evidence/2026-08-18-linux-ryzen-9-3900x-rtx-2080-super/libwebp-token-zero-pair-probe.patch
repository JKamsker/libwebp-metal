@@ -44,6 +45,36 @@ struct VP8Tokens {
 // This macro is used to return their address and hide the trick.
 #define TOKEN_DATA(p) ((const token_t*)&(p)[1])
 
+// Temporary feasibility probe for packing disjoint consecutive zero tokens.
+// Enabled only by WEBP_TOKEN_ZERO_PAIR_PROBE=1 and removed after measurement.
+static int g_zero_pair_probe_enabled = -1;
+static unsigned long long g_zero_pair_probe_calls;
+static unsigned long long g_zero_pair_probe_coeffs;
+static unsigned long long g_zero_pair_probe_zeros;
+static unsigned long long g_zero_pair_probe_pair_coeffs;
+
+static int ZeroPairProbeEnabled(void) {
+  if (g_zero_pair_probe_enabled < 0) {
+    const char* const value = getenv("WEBP_TOKEN_ZERO_PAIR_PROBE");
+    g_zero_pair_probe_enabled =
+        (value != NULL && value[0] == '1' && value[1] == '\0');
+  }
+  return g_zero_pair_probe_enabled;
+}
+
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((destructor))
+#endif
+static void ReportZeroPairProbe(void) {
+  if (g_zero_pair_probe_enabled > 0) {
+    fprintf(stderr,
+            "token zero-pair probe: calls=%llu coeffs=%llu zeros=%llu "
+            "pair_coeffs=%llu\n",
+            g_zero_pair_probe_calls, g_zero_pair_probe_coeffs,
+            g_zero_pair_probe_zeros, g_zero_pair_probe_pair_coeffs);
+  }
+}
+
