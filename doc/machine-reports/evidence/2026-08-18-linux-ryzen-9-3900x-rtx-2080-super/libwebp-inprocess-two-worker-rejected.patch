+typedef struct {
+  const Options* options;
+  const Input* input;
+  WebPMemoryWriter writer;
+  int encoded;
+} ParallelEncodeJob;
+
+static int ParallelEncodeInput(void* data1, void* data2) {
+  ParallelEncodeJob* const job = (ParallelEncodeJob*)data1;
+  (void)data2;
+  job->encoded = EncodeInput(job->options, job->input, &job->writer);
+  return job->encoded;
+}
+
+// Runs two complete encodes at a time. Each worker receives a dedicated CUDA
+// decimate slot, while the parent consumes completed writers in submission
+// order. At most two decoded pictures, outputs, and accelerator arenas are
+// live, so the memory and ordering bounds do not depend on batch size.
+static int RunParallelEncodeBatch(const Options* const options,
+                                  uint64_t* const elapsed_ns,
+                                  uint64_t* const output_hash,
+                                  uint64_t* const output_bytes) {
+  const WebPWorkerInterface* const worker_interface =
+      WebPGetWorkerInterface();
+  WebPWorker workers[2];
+  ParallelEncodeJob jobs[2];
+  uint64_t hash = UINT64_C(1469598103934665603);
+  uint64_t bytes = 0;
+  uint64_t begin, end;
+  int workers_ready = 0;
+  int ok = 0;
+  int i;
+  memset(workers, 0, sizeof(workers));
+  memset(jobs, 0, sizeof(jobs));
+  for (i = 0; i < 2; ++i) {
+    worker_interface->Init(&workers[i]);
